# Node.js 22.9+ · npm start
PORT=3210
HOST=127.0.0.1
# Initial executor: codex (ChatGPT subscription), api, or demo.
OFFICE_EXECUTOR=codex
# Optional executable path. Empty = detect installed Codex.
CODEX_BIN=
# Optional existing project absolute path. Empty = project root.
CODEX_WORKDIR=
# Only used in API mode. A Chat Completions compatible /v1 base URL.
LLM_BASE_URL=
LLM_API_KEY=
MODEL_LUNA=gpt-5.6-luna
MODEL_TERRA=gpt-5.6-terra
MODEL_SOL=gpt-5.6-sol
MODEL_ASTRA=gpt-6-astra
# Optional shared password, stored as an HttpOnly session after login.
OFFICE_PASSWORD=
# HOST=0.0.0.0 for direct access over your Tailscale IP.
# Recommended: keep localhost and use tailscale serve --bg 3210.

# Optional results website port. Default = PORT + 2; binds only to the Tailscale IPv4 address.
# TAIL_WEB_PORT=3212
