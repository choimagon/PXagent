{
  "name": "px-agents-office",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop": "npm run desktop:prepare && node scripts/start-desktop.mjs",
    "desktop:package": "npm run desktop:prepare && electron-builder --config electron-builder.config.cjs --dir",
    "dist": "npm run desktop:prepare && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "npm run desktop:prepare && electron-builder --config electron-builder.config.cjs --mac",
    "dist:win": "npm run desktop:prepare && electron-builder --config electron-builder.config.cjs --win",
    "dist:linux": "npm run desktop:prepare && electron-builder --config electron-builder.config.cjs --linux"
  },
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "@openai/codex": "0.154.0",
    "@playwright/test": "^1.58.2",
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.cjs",
  "description": "개인 Codex 계정과 Tailscale로 일하는 에이전트 사무실",
  "author": "PXagents",
  "license": "UNLICENSED"
}
